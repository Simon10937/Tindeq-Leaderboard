# Local-only mode lets friends try the app without Supabase.
NEXT_PUBLIC_LOCAL_DEMO=true

# Private sync mode:
# 1. Create invited users in Supabase Auth.
# 2. Set NEXT_PUBLIC_LOCAL_DEMO=false.
# 3. Replace these with the project's real public values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only secret. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Public URL used for email auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
